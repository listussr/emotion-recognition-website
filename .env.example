# Пример переменных окружения для деплоя.
# ---
# На сервере: скопируй в .env и заполни:
#     cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).
#
# Эти значения docker compose подставляет в docker-compose.prod.yml
# при `docker compose -f docker-compose.yml -f docker-compose.prod.yml up`.

# Домен сайта для автоматического HTTPS через Caddy.
#   - укажи свой домен (DNS должен указывать на IP сервера), напр.: demo-emotionai.duckdns.org
#   - оставь пустым, чтобы поднять сайт по HTTP на IP сервера (фаза 1 / тест без TLS).
SITE_ADDRESS=

# --- Необязательные переопределения настроек backend ---------------------
# Раскомментируй и поправь при необходимости. По умолчанию берутся значения
# из docker-compose.prod.yml / backend/app/config.py.
# MAX_FILE_SIZE_MB=50
# MAX_VIDEO_DURATION_SEC=30
